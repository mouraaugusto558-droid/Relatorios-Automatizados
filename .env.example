NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DATABASE_PATH=./storage/database.sqlite

WHATSAPP_AUTH_PATH=./storage/whatsapp/auth

REPORTS_PATH=./storage/reports

LOG_LEVEL=info

OTODATA_API_KEY=
OPENAI_API_KEY=
REPORT_RECIPIENT_NUMBER=

# Supabase — projeto Postgres onde as leituras dos tanques são sincronizadas.
# Use a service role key (nunca a anon key aqui, backend só).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets — planilha onde as leituras dos tanques são sincronizadas.
# Crie uma Service Account no Google Cloud Console, baixe a chave JSON e
# compartilhe a planilha (GOOGLE_SHEETS_SPREADSHEET_ID é o ID na URL da planilha)
# com o e-mail da service account como Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
