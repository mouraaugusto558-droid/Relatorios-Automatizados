NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DATABASE_PATH=./storage/database.sqlite

WHATSAPP_AUTH_PATH=./storage/whatsapp/auth

REPORTS_PATH=./storage/reports

LOG_LEVEL=info

OTODATA_API_KEY=
REPORT_RECIPIENT_NUMBER=

# Login do painel (usuário único, sem cadastro). Gere o hash com:
#   npm run generate-password-hash --workspace backend -- "sua-senha-aqui"
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Chave usada para assinar o cookie de sessão (string aleatória longa), ex.:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=

# Origem exata do frontend quando front e back ficam em domínios diferentes
# (ex.: https://meuapp.vercel.app). Deixe vazio em dev local same-origin.
CORS_ALLOWED_ORIGIN=
